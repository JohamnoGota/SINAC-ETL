# SINAC data 
/datasets

# Credentials
/aws

**/.terraform/*
# .tfstate files - store infrastructure state, may contain secrets
*.tfstate
*.tfstate.*

# Crash log files
crash.log
crash.*.log

# Exclude all .tfvars files - likely contain sensitive data (passwords, keys)
*.tfvars
*.tfvars.json

# Ignore override files as they are usually used to override resources locally
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Ignore CLI configuration files
.terraformrc
terraform.rc

# Ignore transient lock info files created by terraform apply
.terraform.tfstate.lock.info

# System created files
.DS_Store